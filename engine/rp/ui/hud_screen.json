{
  "namespace": "hud",

  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          { "openchara_hud@oc_hud.root": {} }
        ]
      }
    ]
  },

  "hud_title_text": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          { "binding_name": "#hud_title_text_string", "binding_type": "global" },
          {
            "binding_type": "view",
            "source_property_name": "(not (('%.4s' * #hud_title_text_string) = 'ocH|'))",
            "target_property_name": "#visible"
          }
        ]
      }
    ]
  }
}

{
  "format_version": "1.21.10",
  "minecraft:entity": {
    "description": {
      "identifier": "{{ns}}:container_wide",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false
    },
    "components": {
      "minecraft:type_family": { "family": ["{{ns}}_container", "inanimate"] },
      "minecraft:collision_box": { "width": 0.6, "height": 0.6 },
      "minecraft:physics": { "has_gravity": false, "has_collision": false },
      "minecraft:pushable": { "is_pushable": false, "is_pushable_by_piston": false },
      "minecraft:health": { "value": 1000000, "max": 1000000 },
      "minecraft:damage_sensor": { "triggers": { "deals_damage": false } },
      "minecraft:knockback_resistance": { "value": 1.0 },
      "minecraft:nameable": { "always_show": true, "allow_name_tag_renaming": false },
      "minecraft:persistent": {},
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:tameable": { "probability": 1.0, "tame_items": ["minecraft:bone"], "tame_event": { "event": "{{ns}}:container_tamed", "target": "self" } }
    },
    "events": {
      "{{ns}}:container_tamed": { "add": { "component_groups": ["{{ns}}_container_tamed"] } }
    },
    "component_groups": {
      "{{ns}}_container_tamed": {
        "minecraft:is_tamed": {},
        "minecraft:is_chested": {},
        "minecraft:inventory": { "container_type": "horse", "inventory_size": 30, "private": false, "restrict_to_owner": true }
      }
    }
  }
}
